# Gemini feedback-brief tests only. Copy to .env.local and add your key there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local voice-memo transcription (worker). Set these in the shell that starts `npm run dev`;
# the worker does not read .env.local. Nothing is sent over the network.
# WHISPER_CPP_PATH=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL_PATH=/path/to/ggml-small.bin
# WHISPER_LANGUAGE=ko
