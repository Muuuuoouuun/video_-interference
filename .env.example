# Gemini feedback-brief tests only. Copy to .env.local and add your key there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional explicit Vertex feedback test: pass --vertex and --live separately.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# App Vertex settings belong in the ignored .env.vertex.local file.
# Image, video and audio generation remain off unless explicitly enabled.
# VI_VERTEX_GENERATION_ENABLED=1
# Explicit request interpretation uses Vertex Gemini and Google ADC when selected.
# VI_INTERPRETER_PROVIDER=vertex
# VERTEX_ACCESS_TOKEN is a short-lived OAuth token supplied in the shell, not a file.
